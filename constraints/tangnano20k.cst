// Tang Nano 20K (GW2AR-LV18QN88C8/I7, package QFN88) pin constraints,
// for the open-source yosys+nextpnr-himbaechel+apycula flow -- see
// scripts/build.sh and docs/bringup.md.
//
// Pin numbers below are cross-checked against Sipeed's own official
// example repo (github.com/sipeed/TangNano-20K-example: led/blink_leds,
// uart/, picorv32/), not just community references. That check caught
// a real bug in an earlier version of this file: uart_rx_pin/uart_tx_pin
// were on 18/17 (which are actually two of the onboard LEDs) instead of
// the real UART pins 70/69.

// IO_TYPE=LVCMOS33 is required on every port below: these pins' banks
// (3, 6, 7) are shared with other fixed-3.3V-bank pins on this device,
// and Gowin's placer rejects any unconstrained port in those banks
// (defaults to LVCMOS18, which conflicts -- error CT1136). Confirmed
// against Sipeed's official examples (led/blink_leds, uart/, picorv32/
// under github.com/sipeed/TangNano-20K-example), which all set
// IO_TYPE=LVCMOS33 explicitly on every port.

IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Pin 88 (Sipeed "KEY1", chip pin name MODE0) is NOT used as a reset
// input -- see rtl/top/clk_reset_gen.vhd for why (it reads permanently
// low on real hardware regardless of button state).

// uart_rx_pin = FPGA's receive pin = wired to the USB-UART bridge's TX.
IO_LOC "uart_rx_pin" 70;
IO_PORT "uart_rx_pin" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// uart_tx_pin = FPGA's transmit pin = wired to the USB-UART bridge's RX.
IO_LOC "uart_tx_pin" 69;
IO_PORT "uart_tx_pin" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "led_n[0]" 15;
IO_LOC "led_n[1]" 16;
IO_LOC "led_n[2]" 17;
IO_LOC "led_n[3]" 18;
IO_LOC "led_n[4]" 19;
IO_LOC "led_n[5]" 20;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
